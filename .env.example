DATABASE_URL=
TEST_DATABASE_URL=
E2E_PRODUCTION_DATABASE_HOSTNAME=
E2E_DATABASE_SENTINEL=
ANALYTICS_HASH_SECRET=
ANALYTICS_HASH_SECRET_PREVIOUS=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_ORG=laflabs-inc
CRON_SECRET=
# Generate this as 32 random bytes encoded with standard base64, for example:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
AI_CREDENTIAL_ENCRYPTION_KEY=
# Generate an independent secret of at least 32 random bytes with the same command. Do not reuse any other secret.
AI_COOKIE_SECRET=
# Vercel adds these when the public and private Blob stores are connected with
# the custom prefixes PUBLIC and PRIVATE. OIDC is automatic; do not add a
# long-lived BLOB_READ_WRITE_TOKEN.
PUBLIC_BLOB_STORE_ID=
PRIVATE_BLOB_STORE_ID=
PRIVATE_BLOB_WEBHOOK_PUBLIC_KEY=
NEXT_PUBLIC_SITE_URL=https://laflabs.co
